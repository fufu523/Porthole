{"sourceLanguage":"en","strings":{"NSLocalNetworkUsageDescription":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Porthole uses the local network to pair this iPhone with itself so JIT can be switched on without a computer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Porthole 使用本地网络将这台 iPhone 与自身配对，以便无需电脑即可开启 JIT。"}}}}},"version":"1.0"}