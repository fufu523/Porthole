    "\\(ask.reason) Porthole can fix this by changing one setting of this game. \\(ask.done) Nothing changes unless you tap Apply; the x leaves the game as it is. Undo is there afterwards.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(ask.reason) Porthole can fix this by changing one setting of this game. \\(ask.done) Nothing changes unless you tap Apply; the x leaves the game as it is. Undo is there afterwards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(ask.reason) Porthole 可以通过更改此游戏的一项设置来修复此问题。\\(ask.done) 除非你点按“应用”，否则不会有任何更改；点按 x 会保持游戏原样。之后可以撤销。"
          }
        }
      }
    },
    "\\(at + 1) of \\(games.count)": {
      "localizations": {
