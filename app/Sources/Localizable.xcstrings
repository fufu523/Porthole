    },
    "You are not subscribed to any \\(name) Workshop items. Choose “Browse and search” to find some.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not subscribed to any \\(name) Workshop items. Choose “Browse and search” to find some."
          }
        },
