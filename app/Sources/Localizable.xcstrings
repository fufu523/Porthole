      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DLC you own is installed with the game, as in Steam. Turning one off keeps files already on the device; it only stops new ones from being downloaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你拥有的 DLC 会随游戏一起安装，与 Steam 相同。关闭某个 DLC 会保留设备上已有的文件；仅停止下载新的文件。"
