    "Porthole has to close and open again before the next game. Your games, saves and settings are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Porthole has to close and open again before the next game. Your games, saves and settings are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Porthole 需要关闭并重新打开后才能玩下一款游戏。你的游戏、存档和设置都会保留。"
          }
        }
      }
    },
    "Porthole is free software. You may use, study, change and share it under the terms of the GNU General Public License, version 3 or later. There is no warranty.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Porthole is free software. You may use, study, change and share it under the terms of the GNU General Public License, version 3 or later. There is no warranty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Porthole 是自由软件。你可以按照 GNU 通用公共许可证第 3 版或更高版本的条款使用、研究、修改和分享它。本软件不提供任何担保。"
          }
        }
      }
    },
    "Porthole is installed. It restarts by itself; if it does not, open it from the Home Screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Porthole is installed. It restarts by itself; if it does not, open it from the Home Screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Porthole 已安装。它会自动重启；如果没有，请从主屏幕打开它。"
          }
        }
      }
    },
    "Porthole makes a small text file with what a person fixing this needs. It is not sent anywhere: you choose where it goes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Porthole makes a small text file with what a person fixing this needs. It is not sent anywhere: you choose where it goes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Porthole 会生成一个小的文本文件，包含修复此问题的人所需的信息。它不会发送到任何地方：由你决定它的去向。"
          }
        }
      }
    },
    "Porthole switched it off to turn on JIT or install an update and could not switch it back on. Tap Turn on to run the shortcut, or turn it on in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Porthole switched it off to turn on JIT or install an update and could not switch it back on. Tap Turn on to run the shortcut, or turn it on in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Porthole 为了开启 JIT 或安装更新而将其关闭，但无法重新开启。点按“开启”以运行快捷指令，或在设置中开启它。"
          }
        }
      }
    },
