    "Found when Porthole opened again, \\(crash.record.started.formatted(date: .abbreviated, time: .shortened)). Its log was kept, so the report has the run that ended and not the launch that followed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found when Porthole opened again, \\(crash.record.started.formatted(date: .abbreviated, time: .shortened)). Its log was kept, so the report has the run that ended and not the launch that followed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Porthole 再次打开时发现，\\(crash.record.started.formatted(date: .abbreviated, time: .shortened))。其日志已保留，因此报告包含已结束的那次运行，而不是随后启动的那次。"
          }
        }
      }
    },
