    "GOG games install by downloading GOG's own setup file and running it inside Porthole. Achievements and other Galaxy features work for games installed from GOG's own builds (Settings > Stores > GOG).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GOG games install by downloading GOG's own setup file and running it inside Porthole. Achievements and other Galaxy features work for games installed from GOG's own builds (Settings > Stores > GOG)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GOG 游戏通过下载 GOG 自己的安装文件并在 Porthole 内运行来安装。对于从 GOG 自己的版本安装的游戏，成就和其他 Galaxy 功能可用（设置 > 商店 > GOG）。"
          }
        }
      }
