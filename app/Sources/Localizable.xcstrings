      }
    },
    "You haven't sent any reports. Open one of your games and tell people how it ran.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't sent any reports. Open one of your games and tell people how it ran."
          }
