    },
    "Switches of the game engine. Every option starts on Default, which leaves the engine as it is. Most apply the next time a game starts. Settings that have a page of their own, such as swap, video memory and resolution, are not repeated here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches of the game engine. Every option starts on Default, which leaves the engine as it is. Most apply the next time a game starts. Settings that have a page of their own, such as swap, video memory and resolution, are not repeated here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏引擎的开关。每个选项最初都设为“默认”，即保持引擎原样。大多数选项会在游戏下次启动时生效。拥有独立页面的设置，如交换、显存和分辨率，不会在此处重复出现。"
          }
        }
      }
    },
