    },
    "This install has no tunnel of its own, which saves an App ID and leaves your own VPN alone. If your JIT tool needs a private link, turn LocalDevVPN on before you press Play.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This install has no tunnel of its own, which saves an App ID and leaves your own VPN alone. If your JIT tool needs a private link, turn LocalDevVPN on before you press Play."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此安装没有自己的隧道，可节省一个 App ID，也不会影响你自己的 VPN。如果你的 JIT 工具需要专用链接，请在点击开始游戏前打开 LocalDevVPN。"
          }
        }
      }
    },
