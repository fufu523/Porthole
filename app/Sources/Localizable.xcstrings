    "For point-and-click and strategy games and anything with small targets: Trackpad keeps your finger off the thing you are aiming at. A first-person game's look-around is not affected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For point-and-click and strategy games and anything with small targets: Trackpad keeps your finger off the thing you are aiming at. A first-person game's look-around is not affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于指向点击和策略游戏，以及任何有小目标的游戏：触控板可让你的手指避开你瞄准的目标。第一人称游戏的环视不受影响。"
          }
        }
      }
    },
